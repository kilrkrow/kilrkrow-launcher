<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#0A0C12</Color>
    <Color x:Key="GlassColor">#D2161820</Color>
    <Color x:Key="GlassHiColor">#22FFFFFF</Color>
    <Color x:Key="TealColor">#3ED9C8</Color>
    <Color x:Key="GoldColor">#D4B06A</Color>
    <Color x:Key="OkColor">#2EE6A6</Color>
    <Color x:Key="BadColor">#FF5D6C</Color>
    <Color x:Key="Text1Color">#F4F7FB</Color>
    <Color x:Key="Text2Color">#B7BDC8</Color>
    <Color x:Key="Text3Color">#7E8694</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}" />
    <SolidColorBrush x:Key="GlassHiBrush" Color="{StaticResource GlassHiColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
    <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1Color}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="BorderHiBrush" Color="#663ED9C8" />
    <SolidColorBrush x:Key="RowBrush" Color="#B414161E" />
    <SolidColorBrush x:Key="InputBrush" Color="#E00E1016" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#28FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C8FF5D6C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="#221C222C"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderHiBrush}" />
                            <Setter TargetName="bd" Property="Background" Value="#333ED9C8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="#333ED9C8"
                            BorderBrush="{StaticResource BorderHiBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#553ED9C8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Width="20" Height="20"
                            Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Path x:Name="mark"
                              Data="M3,9 L8,14 L17,4"
                              Stroke="{StaticResource TealBrush}"
                              StrokeThickness="2"
                              Visibility="Collapsed"
                              Stretch="Uniform"
                              Margin="3" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
        <Setter Property="Background" Value="#22FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource TealBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Height" Value="32" />
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
    </Style>
</ResourceDictionary>
