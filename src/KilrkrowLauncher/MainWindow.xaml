<Window x:Class="KilrkrowLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KilrkrowLauncher.ViewModels"
        Title="kilrkrow Launcher"
        Width="920" Height="640"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource Text1Brush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="Assets/launcher.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#E00A0C12">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="48" Background="#CC12141C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="22" Height="22" Source="Assets/launcher.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="kilrkrow Launcher" />
                        <TextBlock Margin="10,2,0,0" FontSize="11" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"
                                   Text="public utilities" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="-" Click="MinimizeClick" ToolTip="Minimize" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="x" Click="CloseClick" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="#CC12141C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Margin="16,10,16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GlassButton}" Content="Refresh catalog" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Launch all" Command="{Binding LaunchAllCommand}"
                                ToolTip="Starts checked tools that are already installed. Missing rows are skipped." />
                        <Button Grid.Column="2" Style="{StaticResource GlassButton}" Content="Update launcher" Margin="10,0,10,0"
                                Command="{Binding UpdateLauncherCommand}"
                                Visibility="{Binding UpdateAvailable, Mode=OneWay, Converter={x:Static vm:BoolToVis.Instance}}"
                                ToolTip="Download the newer launcher asset and restart." />
                        <TextBlock Grid.Column="3" Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource Text2Brush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Expander Margin="0,10,0,0" Header="Optional GitHub token (local only, not required)"
                              Foreground="{StaticResource Text3Brush}" FontSize="11">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TokenBox" MaxLength="200" ToolTip="Raises the unauthenticated 60/hr limit. Leave empty for public catalog." />
                            <Button Grid.Column="1" Style="{StaticResource GlassButton}" MinWidth="88" Margin="10,0,0,0"
                                    Content="Save" Click="SaveTokenClick" />
                        </Grid>
                    </Expander>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Text3Brush}" Text="{Binding TokenHint}" />
                </StackPanel>
            </Border>

            <Border Margin="16" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="168" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource Text3Brush}" FontSize="11" Text="Pick" />
                        <TextBlock Grid.Column="1" Foreground="{StaticResource Text3Brush}" FontSize="11" Text="Tool" />
                        <TextBlock Grid.Column="2" Foreground="{StaticResource Text3Brush}" FontSize="11" Text="Release" />
                        <TextBlock Grid.Column="3" Foreground="{StaticResource Text3Brush}" FontSize="11" Text="State" />
                        <TextBlock Grid.Column="4" Foreground="{StaticResource Text3Brush}" FontSize="11" Text="Action" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,10">
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ToolRowViewModel}">
                                    <Border Margin="0,0,0,8" Padding="10,8" Background="{StaticResource RowBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                            MinHeight="68">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" MinWidth="160" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="168" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                                      ToolTip="Include in Launch all (installed rows only)." />
                                            <StackPanel Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource Text2Brush}"
                                                           Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Description}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Tag}" Foreground="{StaticResource Text2Brush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Padding="8,3" CornerRadius="10" Background="#22000000"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource GoldBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StateLabel}" Value="Installed">
                                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StateLabel}" Value="Running">
                                                                    <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StateLabel}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="{Binding ActionLabel}"
                                                        Command="{Binding ActionCommand}" />
                                                <StackPanel Visibility="{Binding ShowProgress, Mode=OneWay, Converter={x:Static vm:BoolToVis.Instance}}">
                                                    <ProgressBar Margin="0,6,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                                                    <DockPanel Margin="0,4,0,0">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}"
                                                                MinWidth="72" MinHeight="24" Padding="8,2" FontSize="11"
                                                                Content="Cancel" Command="{Binding CancelCommand}" />
                                                        <TextBlock Text="{Binding ProgressText, Mode=OneWay}" FontSize="11"
                                                                   Foreground="{StaticResource Text3Brush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Text3Brush}"
                               Text="No Windows tools yet. Refresh the catalog."
                               Visibility="{Binding HasTools, Converter={x:Static vm:InverseBoolToVis.Instance}}" />
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
